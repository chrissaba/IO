{
  "action": {
    "default_icon": {
      "128": "icons/icon-128.png",
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_title": "IO"
  },
  "background": {
    "service_worker": "lib/background.mjs",
    "type": "module"
  },
  "description": "Lets IO, your local assistant, use this Chrome. IO's tabs are grouped as IO. Based on the Playwright Extension (Apache-2.0).",
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "128": "icons/icon-128.png",
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png"
  },
  "key": "",
  "manifest_version": 3,
  "name": "IO",
  "permissions": [
    "debugger",
    "activeTab",
    "tabs",
    "tabGroups"
  ],
  "version": "0.4.0.1"
}